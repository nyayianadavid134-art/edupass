<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>EduPass | Accept invitation</title><link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/auth.css"></head><body class="auth-body"><main class="auth-page"><section class="auth-showcase register-showcase"><a class="brand auth-brand" href="/"><span class="brand-mark">E</span><span>EduPass</span></a><div class="showcase-copy"><p class="eyebrow auth-eyebrow">YOU'RE INVITED</p><h1>Welcome to<br><em><%= invitation ? invitation.school_name : 'your school' %>.</em></h1><p>Set up your account to join your school workspace with the access assigned by your administrator.</p></div></section><section class="auth-panel"><div class="auth-form-wrap register-form-wrap"><div class="mobile-brand"><a class="brand auth-brand" href="/"><span class="brand-mark">E</span><span>EduPass</span></a></div><p class="eyebrow">SCHOOL INVITATION</p><h2>Set up your account</h2><p class="auth-copy"><%= invitation ? `You are joining as a ${invitation.role.replaceAll('_', ' ')}.` : 'This invitation cannot be used.' %></p><% if (error) { %><div class="form-error" role="alert"><span>!</span><%= error %></div><% } %><% if (invitation) { %><form method="post" action="/invite/<%= token %>" class="auth-form"><label>Email<input type="email" value="<%= invitation.email %>" readonly></label><label for="inviteName">Full name<input id="inviteName" type="text" name="fullName" placeholder="e.g. Mary John" required autocomplete="name"></label><label for="invitePassword">Create password<input id="invitePassword" type="password" name="password" minlength="8" placeholder="At least 8 characters" required autocomplete="new-password"></label><button class="button full-button" type="submit">Join school workspace <span>→</span></button></form><% } %><p class="auth-switch"><a href="/login">Go to sign in</a></p></div></section></main></body></html>
