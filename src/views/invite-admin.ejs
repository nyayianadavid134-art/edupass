<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>EduPass | Invite people</title><link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/auth.css"></head>
<body class="auth-body"><main class="auth-page"><section class="auth-showcase register-showcase"><a class="brand auth-brand" href="/"><span class="brand-mark">E</span><span>EduPass</span></a><div class="showcase-copy"><p class="eyebrow auth-eyebrow">SCHOOL ADMINISTRATION</p><h1>Bring your<br><em>people in.</em></h1><p>Invite the people who make your school work. Every invitation is tied to your school and one defined role.</p></div><div class="role-preview"><span class="preview-check">✓</span><div><strong>One connected school</strong><small>Staff, parents, and students share the right workspace.</small></div></div></section><section class="auth-panel"><div class="auth-form-wrap register-form-wrap"><div class="mobile-brand"><a class="brand auth-brand" href="/"><span class="brand-mark">E</span><span>EduPass</span></a></div><p class="eyebrow">INVITE A TEAM MEMBER</p><h2>Send an invitation</h2><p class="auth-copy">Only school administrators can create accounts for this school.</p><% if (error) { %><div class="form-error" role="alert"><span>!</span><%= error %></div><% } %><% if (inviteLink) { %><div class="invite-success"><strong>Invitation ready</strong><span>Share this one-time link with the invitee:</span><code><%= inviteLink %></code></div><% } %><form method="post" action="/workspace/invitations" class="auth-form"><label for="inviteEmail">Invitee email<input id="inviteEmail" type="email" name="email" placeholder="person@school.org" required autocomplete="email"></label><label for="inviteRole">Role<select id="inviteRole" name="role" required><option value="" disabled selected>Select a school role</option><% roles.forEach(function(item) { %><option value="<%= item.value %>"><%= item.label %></option><% }); %></select></label><button class="button full-button" type="submit">Create invitation <span>→</span></button></form><p class="auth-switch"><a href="/">← Return to dashboard</a></p></div></section></main></body></html>
