<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>EduPass | Identity verification</title><link rel="stylesheet" href="/styles.css"></head><body><main class="error-page"><div class="brand"><span class="brand-mark">E</span><span>EduPass</span></div><p class="eyebrow">EDUPASS IDENTITY VERIFICATION</p><% if (identity && identity.status === 'active') { %><h1>✓ Verified identity</h1><p><strong><%= identity.school_name %></strong></p><div class="panel permission-panel"><p><strong>Name</strong><br><%= identity.full_name %></p><p><strong>Student ID</strong><br><%= identity.student_number %></p><p><strong>Status</strong><br>ACTIVE</p><p><strong>School</strong><br><%= identity.city || '' %><%= identity.city && identity.country ? ', ' : '' %><%= identity.country || '' %></p></div><% } else if (identity) { %><h1>ID not active</h1><p>This EduPass identity is currently <strong><%= identity.status %></strong>. Contact the school administration.</p><% } else { %><h1>Identity not found</h1><p>This verification link is invalid or no longer available.</p><% } %></main></body></html>
