<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>EduPass | <%= module.title %></title><link rel="stylesheet" href="/styles.css"><style>
.attendance-intro{display:flex;justify-content:space-between;gap:24px;align-items:end}.attendance-grid{display:grid;grid-template-columns:minmax(280px,360px) 1fr;gap:22px;margin-top:22px}.qr-panel{margin-top:22px}.qr-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:14px}.qr-card{border:1px solid var(--line);border-radius:12px;padding:14px;text-align:center;background:#fff}.qr-card img{width:112px;height:112px;display:block;margin:0 auto 10px}.qr-card strong{display:block;font-size:13px}.qr-card small{display:block;color:var(--muted);margin-top:4px}.attendance-table{overflow:auto}.attendance-table table{min-width:520px}@media(max-width:800px){.attendance-grid{grid-template-columns:1fr}.attendance-intro{display:block}.main-content{padding:22px 18px 40px}.sidebar{width:210px}.main-content{width:calc(100% - 210px)}}
</style></head>
<body><div class="app-shell"><aside class="sidebar"><div class="brand"><img src="/images/logo1.png" alt="EduPass" style="width:150px;height:auto;display:block"></div><div class="workspace-label"><%= dashboard.eyebrow %></div><nav><% dashboard.navigation.forEach(function(item) { if (canAccess(user.role, item[2])) { %><a class="nav-item <%= item[1].includes(workspace) ? 'active' : '' %>" href="<%= item[1] %>"><span class="nav-dot"></span><%= item[0] %></a><% } }); %></nav><div class="sidebar-footer"><div class="status-dot"></div><span>Role access active</span></div></aside>
<main class="main-content"><header class="topbar"><div><p class="eyebrow"><%= module.eyebrow %></p><h1><%= module.title %></h1><span class="role-chip"><%= user.roleLabel %></span></div><div class="top-actions"><a class="button light-button" href="/">Dashboard</a><form method="post" action="/logout"><button class="logout-button" type="submit">Sign out</button></form></div></header><section class="module-hero attendance-intro"><div><p class="eyebrow light">FAST CHECK-IN</p><h2><%= module.description %></h2><p>Use the student QR card or select a student manually. Records are limited to your school.</p></div></section>
<div class="attendance-grid"><div class="panel form-panel"><p class="eyebrow">MANUAL REGISTER</p><h3>Record attendance</h3><form method="post" action="/workspace/attendance" class="workspace-form"><label>Student<select name="studentId" required><option value="" disabled <%= selectedStudentId ? '' : 'selected' %>>Select student</option><% students.forEach(function(student) { %><option value="<%= student.id %>" <%= selectedStudentId === student.id ? 'selected' : '' %>><%= student.full_name %> · <%= student.student_number %></option><% }); %></select></label><label>Date<input name="date" type="date"></label><label>Status<select name="status" required><option value="present">Present</option><option value="absent">Absent</option><option value="late">Late</option><option value="excused">Excused</option><option value="left_school">Left school</option></select></label><button class="button" type="submit">Save attendance <span>→</span></button></form></div><div class="panel table-panel attendance-table"><div class="panel-heading"><div><p class="eyebrow">RECENT RECORDS</p><h3><%= records.length %> attendance records</h3></div></div><table><thead><tr><th>Date</th><th>Student</th><th>Status</th></tr></thead><tbody><% records.forEach(function(record) { %><tr><td><%= record.attendance_date %></td><td><strong><%= record.full_name %></strong><small><%= record.student_number %></small></td><td><span class="status-pill"><%= record.status %></span></td></tr><% }); %></tbody></table><% if (!records.length) { %><p class="empty-state">No attendance has been recorded yet.</p><% } %></div></div>
<section class="panel qr-panel"><div class="panel-heading"><div><p class="eyebrow">STUDENT QR CARDS</p><h3>Scan to select a student</h3><p class="panel-help">Print or display these cards. Scanning one opens the attendance form with that student selected.</p></div></div><div class="qr-grid"><% studentQrCodes.forEach(function(student) { %><a class="qr-card" href="/workspace/attendance/scan?studentId=<%= student.id %>"><img src="<%= student.qrCode %>" alt="QR code for <%= student.full_name %>"><strong><%= student.full_name %></strong><small><%= student.student_number %></small></a><% }); %></div><% if (!studentQrCodes.length) { %><p class="empty-state">Add students first to generate QR attendance cards.</p><% } %></section>
</main></div></body></html>
