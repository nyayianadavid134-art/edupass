<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>EduPass | <%= module.title %></title><link rel="stylesheet" href="/styles.css"></head>
<body><div class="app-shell"><aside class="sidebar"><div class="brand"><span class="brand-mark">E</span><span>EduPass</span></div><div class="workspace-label"><%= dashboard.eyebrow %></div><nav><% dashboard.navigation.forEach(function(item) { if (canAccess(user.role, item[2])) { %><a class="nav-item <%= item[1].includes(workspace) ? 'active' : '' %>" href="<%= item[1] %>"><span class="nav-dot"></span><%= item[0] %></a><% } }); %></nav><div class="sidebar-footer"><div class="status-dot"></div><span>Role access active</span></div></aside>
<main class="main-content"><header class="topbar"><div><p class="eyebrow"><%= module.eyebrow %></p><h1><%= module.title %></h1><span class="role-chip"><%= user.roleLabel %></span></div><div class="top-actions"><a class="button light-button" href="/">Dashboard</a><form method="post" action="/logout"><button class="logout-button" type="submit">Sign out</button></form></div></header>
<section class="module-hero"><p class="eyebrow light">AUTHORIZED TASK WORKSPACE</p><h2><%= module.description %></h2><p>All records are limited to your school and role.</p></section>
<% if (workspace === 'students' || workspace === 'my-students' || workspace === 'student-lookup') { %><section class="workspace-grid"><% if (canAccess(user.role, 'students.create')) { %><div class="panel form-panel"><p class="eyebrow">NEW RECORD</p><h3>Add student</h3><form method="post" action="/workspace/students" class="workspace-form"><label>Student number<input name="studentNumber" required placeholder="STU-2026-001"></label><label>Full name<input name="fullName" required placeholder="Student full name"></label><button class="button" type="submit">Add student <span>→</span></button></form></div><% } %><div class="panel table-panel"><div class="panel-heading"><div><p class="eyebrow">STUDENT DIRECTORY</p><h3><%= records.length %> student records</h3></div></div><table><thead><tr><th>Student</th><th>Number</th><th>Status</th></tr></thead><tbody><% records.forEach(function(record) { %><tr><td><strong><%= record.full_name %></strong></td><td><%= record.student_number %></td><td><span class="status-pill"><%= record.status %></span></td></tr><% }); %></tbody></table><% if (!records.length) { %><p class="empty-state">No students have been added yet.</p><% } %></div></section>
<% } else if (workspace === 'subjects') { %><section class="workspace-grid"><div class="panel form-panel"><p class="eyebrow">ACADEMIC SETUP</p><h3>Create subject</h3><form method="post" action="/workspace/subjects" class="workspace-form"><label>Subject name<input name="name" required placeholder="Mathematics"></label><label>Subject code<input name="code" placeholder="MATH-101"></label><button class="button" type="submit">Create subject <span>→</span></button></form></div><div class="panel table-panel"><div class="panel-heading"><div><p class="eyebrow">CURRICULUM</p><h3><%= records.length %> subjects</h3></div></div><table><thead><tr><th>Name</th><th>Code</th></tr></thead><tbody><% records.forEach(function(record) { %><tr><td><strong><%= record.name %></strong></td><td><%= record.code || '—' %></td></tr><% }); %></tbody></table><% if (!records.length) { %><p class="empty-state">No subjects have been configured.</p><% } %></div></section>
<% } else if (workspace === 'digital-ids') { %><section class="workspace-grid"><div class="panel form-panel"><p class="eyebrow">IDENTITY & SECURITY</p><h3>Issue digital ID</h3><form method="post" action="/workspace/digital-ids" class="workspace-form"><label>Student<select name="studentId" required><option value="" disabled selected>Select student</option><% students.forEach(function(student) { %><option value="<%= student.id %>"><%= student.full_name %> · <%= student.student_number %></option><% }); %></select></label><label>Expiration date<input type="date" name="expiresAt"></label><button class="button" type="submit">Issue secure ID <span>→</span></button></form><% if (query && query.issued) { %><div class="invite-success"><strong>ID issued</strong><span>Verification link:</span><code>/verify/<%= query.issued %></code></div><% } %></div><div class="panel table-panel"><div class="panel-heading"><div><p class="eyebrow">ISSUED IDENTITIES</p><h3><%= records.length %> digital IDs</h3></div></div><table><thead><tr><th>Student</th><th>Status</th><th>Expires</th></tr></thead><tbody><% records.forEach(function(record) { %><tr><td><strong><%= record.full_name %></strong><small><%= record.student_number %></small></td><td><span class="status-pill"><%= record.status %></span></td><td><%= record.expires_at || 'No expiry' %></td></tr><% }); %></tbody></table></div></section>
<% } else if (workspace === 'attendance' || workspace === 'my-attendance') { %><section class="workspace-grid"><div class="panel form-panel"><p class="eyebrow">DAILY REGISTER</p><h3>Record attendance</h3><form method="post" action="/workspace/attendance" class="workspace-form"><label>Student<select name="studentId" required><option value="" disabled selected>Select student</option><% students.forEach(function(student) { %><option value="<%= student.id %>"><%= student.full_name %> · <%= student.student_number %></option><% }); %></select></label><label>Date<input type="date" name="date"></label><label>Status<select name="status" required><option value="present">Present</option><option value="absent">Absent</option><option value="late">Late</option><option value="excused">Excused</option><option value="left_school">Left school</option></select></label><button class="button" type="submit">Save attendance <span>→</span></button></form></div><div class="panel table-panel"><div class="panel-heading"><div><p class="eyebrow">RECENT RECORDS</p><h3>Attendance register</h3></div></div><table><thead><tr><th>Date</th><th>Student</th><th>Status</th></tr></thead><tbody><% records.forEach(function(record) { %><tr><td><%= record.attendance_date %></td><td><%= record.full_name %></td><td><span class="status-pill"><%= record.status %></span></td></tr><% }); %></tbody></table></div></section>
<% } else if (workspace === 'finance' || workspace === 'invoices' || workspace === 'outstanding-balances') { %><section class="workspace-grid"><div class="panel table-panel full-panel"><div class="panel-heading"><div><p class="eyebrow">FINANCE RECORDS</p><h3><%= records.length %> invoices</h3></div></div><table><thead><tr><th>Invoice</th><th>Student</th><th>Amount</th><th>Balance</th><th>Status</th></tr></thead><tbody><% records.forEach(function(record) { %><tr><td><strong><%= record.invoice_number %></strong><small><%= record.description %></small></td><td><%= record.full_name || 'Unassigned' %></td><td><%= record.amount %></td><td><%= record.balance %></td><td><span class="status-pill"><%= record.status %></span></td></tr><% }); %></tbody></table><% if (!records.length) { %><p class="empty-state">No invoices have been created.</p><% } %></div></section>
<% } else if (workspace === 'visitors') { %><section class="workspace-grid"><div class="panel form-panel"><p class="eyebrow">FRONT DESK</p><h3>Register visitor</h3><form method="post" action="/workspace/visitors" class="workspace-form"><label>Full name<input name="fullName" required></label><label>Phone<input name="phone"></label><label>Email<input name="email" type="email"></label><label>ID number<input name="identificationNumber"></label><label>Purpose<input name="purpose" required></label><button class="button" type="submit">Check in visitor <span>→</span></button></form></div><div class="panel table-panel"><div class="panel-heading"><div><p class="eyebrow">VISITOR LOG</p><h3><%= records.length %> recent visitors</h3></div></div><table><thead><tr><th>Visitor</th><th>Purpose</th><th>Status</th><th>Checked in</th></tr></thead><tbody><% records.forEach(function(record) { %><tr><td><strong><%= record.full_name %></strong><small><%= record.phone || '' %></small></td><td><%= record.purpose %></td><td><span class="status-pill"><%= record.status %></span></td><td><%= record.checked_in_at || '-' %></td></tr><% }); %></tbody></table></div></section>
<% } else if (workspace === 'visitor-passes') { %><section class="workspace-grid"><div class="panel form-panel"><p class="eyebrow">ACCESS CONTROL</p><h3>Issue visitor pass</h3><form method="post" action="/workspace/visitor-passes" class="workspace-form"><label>Visitor<select name="visitorId" required><option value="" disabled selected>Select visitor</option><% visitors.forEach(function(visitor) { %><option value="<%= visitor.id %>"><%= visitor.full_name %></option><% }); %></select></label><label>Expires<input name="expiresAt" type="datetime-local"></label><button class="button" type="submit">Issue pass <span>→</span></button></form></div><div class="panel table-panel"><div class="panel-heading"><div><p class="eyebrow">ACTIVE PASSES</p><h3><%= records.length %> passes</h3></div></div><table><thead><tr><th>Pass</th><th>Visitor</th><th>Status</th><th>Expires</th></tr></thead><tbody><% records.forEach(function(record) { %><tr><td><strong><%= record.pass_code %></strong></td><td><%= record.full_name %></td><td><span class="status-pill"><%= record.status %></span></td><td><%= record.expires_at || '-' %></td></tr><% }); %></tbody></table></div></section>
<% } else if (workspace === 'entry-exit') { %><section class="workspace-grid"><div class="panel form-panel"><p class="eyebrow">MOVEMENT LOG</p><h3>Record movement</h3><form method="post" action="/workspace/entry-exit" class="workspace-form"><label>Student<select name="studentId"><option value="">Not a student</option><% students.forEach(function(student) { %><option value="<%= student.id %>"><%= student.full_name %> · <%= student.student_number %></option><% }); %></select></label><label>Visitor<select name="visitorId"><option value="">Not a visitor</option><% visitors.forEach(function(visitor) { %><option value="<%= visitor.id %>"><%= visitor.full_name %></option><% }); %></select></label><label>Direction<select name="direction" required><option value="entry">Entry</option><option value="exit">Exit</option></select></label><label>Reason<input name="reason"></label><button class="button" type="submit">Save movement <span>→</span></button></form></div><div class="panel table-panel"><div class="panel-heading"><div><p class="eyebrow">RECENT MOVEMENT</p><h3><%= records.length %> records</h3></div></div><table><thead><tr><th>Person</th><th>Direction</th><th>Reason</th><th>Time</th></tr></thead><tbody><% records.forEach(function(record) { %><tr><td><%= record.student_name || record.visitor_name %></td><td><span class="status-pill"><%= record.direction %></span></td><td><%= record.reason || '-' %></td><td><%= record.recorded_at %></td></tr><% }); %></tbody></table></div></section>
<% } else if (workspace === 'emergency-contacts') { %><section class="workspace-grid"><div class="panel form-panel"><p class="eyebrow">STUDENT SAFETY</p><h3>Add emergency contact</h3><form method="post" action="/workspace/emergency-contacts" class="workspace-form"><label>Student<select name="studentId" required><option value="" disabled selected>Select student</option><% students.forEach(function(student) { %><option value="<%= student.id %>"><%= student.full_name %> · <%= student.student_number %></option><% }); %></select></label><label>Contact name<input name="fullName" required></label><label>Relationship<input name="relationship" required></label><label>Phone<input name="phone" required></label><label>Email<input name="email" type="email"></label><label><input name="isPrimary" type="checkbox"> Primary contact</label><button class="button" type="submit">Save contact <span>→</span></button></form></div><div class="panel table-panel"><div class="panel-heading"><div><p class="eyebrow">EMERGENCY DIRECTORY</p><h3><%= records.length %> contacts</h3></div></div><table><thead><tr><th>Student</th><th>Contact</th><th>Relationship</th><th>Phone</th></tr></thead><tbody><% records.forEach(function(record) { %><tr><td><%= record.student_name %></td><td><strong><%= record.full_name %></strong></td><td><%= record.relationship %></td><td><%= record.phone %></td></tr><% }); %></tbody></table></div></section>
<% } else if (['book-categories','books','assignments','events','announcements','my-tasks','vehicles','drivers','routes'].includes(workspace)) { %><section class="workspace-grid"><div class="panel form-panel"><p class="eyebrow">WORKSPACE ACTION</p><h3>Create <%= module.title %></h3><form method="post" action="/workspace/<%= workspace %>" class="workspace-form"><% if (workspace === 'books') { %><label>Title<input name="title" required></label><label>Author<input name="author"></label><label>ISBN<input name="isbn"></label><label>Total copies<input name="copiesTotal" type="number" min="1" value="1" required></label><% } else if (workspace === 'book-categories' || workspace === 'routes') { %><label>Name<input name="name" required></label><label>Description<textarea name="description"></textarea></label><% } else if (workspace === 'drivers') { %><label>Full name<input name="fullName" required></label><label>Phone<input name="phone"></label><label>Licence number<input name="licenceNumber"></label><% } else if (workspace === 'vehicles') { %><label>Registration number<input name="registrationNumber" required></label><label>Vehicle type<input name="vehicleType"></label><label>Capacity<input name="capacity" type="number" min="1"></label><% } else { %><label>Title<input name="title" required></label><label>Description<textarea name="description"></textarea></label><% if (workspace === 'events') { %><label>Starts at<input name="startsAt" type="datetime-local" required></label><label>Location<input name="location"></label><% } else if (workspace === 'announcements') { %><label>Audience<input name="audience" value="school"></label><label>Message<textarea name="body" required></textarea></label><% } else if (workspace === 'my-tasks') { %><label>Due at<input name="dueAt" type="datetime-local"></label><% } else { %><label>Due at<input name="dueAt" type="datetime-local"></label><% } %><% } %><button class="button" type="submit">Save record <span>→</span></button></form></div><div class="panel table-panel"><div class="panel-heading"><div><p class="eyebrow">RECORDS</p><h3><%= records.length %> records</h3></div></div><% if (records.length) { %><table><thead><tr><% Object.keys(records[0]).slice(0, 8).forEach(function(key) { %><th><%= key.replaceAll('_', ' ') %></th><% }); %></tr></thead><tbody><% records.forEach(function(record) { %><tr><% Object.keys(records[0]).slice(0, 8).forEach(function(key) { %><td><%= record[key] || '-' %></td><% }); %></tr><% }); %></tbody></table><% } else { %><p class="empty-state">No records yet.</p><% } %></div></section>
<% } else { %><section class="content-grid"><div class="panel notice-panel"><div class="notice-symbol">!</div><div><p class="eyebrow">WORKSPACE STATUS</p><h3><%= module.title %></h3><p>This workspace is ready for records and authorization. Its specialized forms are being connected to the database.</p></div></div></section><% } %>
</main></div></body></html>
