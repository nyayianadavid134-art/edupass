<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>EduPass | <%= module.title %></title><link rel="stylesheet" href="/styles.css"></head>
<body><div class="app-shell"><aside class="sidebar"><div class="brand"><span class="brand-mark">E</span><span>EduPass</span></div><div class="workspace-label"><%= dashboard.eyebrow %></div><nav><% dashboard.navigation.forEach(function(item) { if (canAccess(user.role, item[2])) { %><a class="nav-item <%= item[1].includes(workspace) ? 'active' : '' %>" href="<%= item[1] %>"><span class="nav-dot"></span><%= item[0] %></a><% } }); %></nav><div class="sidebar-footer"><div class="status-dot"></div><span>Role access active</span></div></aside>
<main class="main-content"><header class="topbar"><div><p class="eyebrow"><%= module.eyebrow %></p><h1><%= module.title %></h1><span class="role-chip"><%= user.roleLabel %></span></div><div class="top-actions"><a class="button light-button" href="/">Dashboard</a><form method="post" action="/logout"><button class="logout-button" type="submit">Sign out</button></form></div></header>
<section class="module-hero"><p class="eyebrow light">AUTHORIZED TASK WORKSPACE</p><h2><%= module.description %></h2><p>All records are limited to your school and role.</p></section>
<% if (workspace === 'students' || workspace === 'my-students' || workspace === 'student-lookup') { %><section class="workspace-grid"><% if (canAccess(user.role, 'students.create')) { %><div class="panel form-panel"><p class="eyebrow">NEW RECORD</p><h3>Add student</h3><form method="post" action="/workspace/students" class="workspace-form"><label>Student number<input name="studentNumber" required placeholder="STU-2026-001"></label><label>Full name<input name="fullName" required placeholder="Student full name"></label><button class="button" type="submit">Add student <span>→</span></button></form></div><% } %><div class="panel table-panel"><div class="panel-heading"><div><p class="eyebrow">STUDENT DIRECTORY</p><h3><%= records.length %> student records</h3></div></div><table><thead><tr><th>Student</th><th>Number</th><th>Status</th></tr></thead><tbody><% records.forEach(function(record) { %><tr><td><strong><%= record.full_name %></strong></td><td><%= record.student_number %></td><td><span class="status-pill"><%= record.status %></span></td></tr><% }); %></tbody></table><% if (!records.length) { %><p class="empty-state">No students have been added yet.</p><% } %></div></section>
<% } else if (workspace === 'subjects') { %><section class="workspace-grid"><div class="panel form-panel"><p class="eyebrow">ACADEMIC SETUP</p><h3>Create subject</h3><form method="post" action="/workspace/subjects" class="workspace-form"><label>Subject name<input name="name" required placeholder="Mathematics"></label><label>Subject code<input name="code" placeholder="MATH-101"></label><button class="button" type="submit">Create subject <span>→</span></button></form></div><div class="panel table-panel"><div class="panel-heading"><div><p class="eyebrow">CURRICULUM</p><h3><%= records.length %> subjects</h3></div></div><table><thead><tr><th>Name</th><th>Code</th></tr></thead><tbody><% records.forEach(function(record) { %><tr><td><strong><%= record.name %></strong></td><td><%= record.code || '—' %></td></tr><% }); %></tbody></table><% if (!records.length) { %><p class="empty-state">No subjects have been configured.</p><% } %></div></section>
<% } else if (workspace === 'digital-ids') { %><section class="workspace-grid"><div class="panel form-panel"><p class="eyebrow">IDENTITY & SECURITY</p><h3>Issue digital ID</h3><form method="post" action="/workspace/digital-ids" class="workspace-form"><label>Student<select name="studentId" required><option value="" disabled selected>Select student</option><% students.forEach(function(student) { %><option value="<%= student.id %>"><%= student.full_name %> · <%= student.student_number %></option><% }); %></select></label><label>Expiration date<input type="date" name="expiresAt"></label><button class="button" type="submit">Issue secure ID <span>→</span></button></form><% if (query && query.issued) { %><div class="invite-success"><strong>ID issued</strong><span>Verification link:</span><code>/verify/<%= query.issued %></code></div><% } %></div><div class="panel table-panel"><div class="panel-heading"><div><p class="eyebrow">ISSUED IDENTITIES</p><h3><%= records.length %> digital IDs</h3></div></div><table><thead><tr><th>Student</th><th>Status</th><th>Expires</th></tr></thead><tbody><% records.forEach(function(record) { %><tr><td><strong><%= record.full_name %></strong><small><%= record.student_number %></small></td><td><span class="status-pill"><%= record.status %></span></td><td><%= record.expires_at || 'No expiry' %></td></tr><% }); %></tbody></table></div></section>
<% } else if (workspace === 'attendance' || workspace === 'my-attendance') { %><section class="workspace-grid"><div class="panel form-panel"><p class="eyebrow">DAILY REGISTER</p><h3>Record attendance</h3><form method="post" action="/workspace/attendance" class="workspace-form"><label>Student<select name="studentId" required><option value="" disabled selected>Select student</option><% students.forEach(function(student) { %><option value="<%= student.id %>"><%= student.full_name %> · <%= student.student_number %></option><% }); %></select></label><label>Date<input type="date" name="date"></label><label>Status<select name="status" required><option value="present">Present</option><option value="absent">Absent</option><option value="late">Late</option><option value="excused">Excused</option><option value="left_school">Left school</option></select></label><button class="button" type="submit">Save attendance <span>→</span></button></form></div><div class="panel table-panel"><div class="panel-heading"><div><p class="eyebrow">RECENT RECORDS</p><h3>Attendance register</h3></div></div><table><thead><tr><th>Date</th><th>Student</th><th>Status</th></tr></thead><tbody><% records.forEach(function(record) { %><tr><td><%= record.attendance_date %></td><td><%= record.full_name %></td><td><span class="status-pill"><%= record.status %></span></td></tr><% }); %></tbody></table></div></section>
<% } else if (workspace === 'finance' || workspace === 'invoices' || workspace === 'outstanding-balances') { %><section class="workspace-grid"><div class="panel table-panel full-panel"><div class="panel-heading"><div><p class="eyebrow">FINANCE RECORDS</p><h3><%= records.length %> invoices</h3></div></div><table><thead><tr><th>Invoice</th><th>Student</th><th>Amount</th><th>Balance</th><th>Status</th></tr></thead><tbody><% records.forEach(function(record) { %><tr><td><strong><%= record.invoice_number %></strong><small><%= record.description %></small></td><td><%= record.full_name || 'Unassigned' %></td><td><%= record.amount %></td><td><%= record.balance %></td><td><span class="status-pill"><%= record.status %></span></td></tr><% }); %></tbody></table><% if (!records.length) { %><p class="empty-state">No invoices have been created.</p><% } %></div></section>
<% } else { %><section class="content-grid"><div class="panel notice-panel"><div class="notice-symbol">!</div><div><p class="eyebrow">WORKSPACE STATUS</p><h3><%= module.title %></h3><p>This workspace is scaffolded but not fully wired to a real data source in this build. The backend currently exposes the module name and role authorization, but records and actions are not yet implemented here.</p></div></div></section><% } %>
</main></div></body></html>
