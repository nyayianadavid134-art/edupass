<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>EduPass | <%= module.title %></title><link rel="stylesheet" href="/styles.css"></head>
<body><div class="app-shell"><aside class="sidebar"><div class="brand"><span class="brand-mark">E</span><span>EduPass</span></div><div class="workspace-label"><%= dashboard.eyebrow %></div><nav><% dashboard.navigation.forEach(function(item) { if (canAccess(user.role, item[2])) { %><a class="nav-item" href="<%= item[1] %>"><span class="nav-dot"></span><%= item[0] %></a><% } }); %></nav></aside><main class="main-content"><header class="topbar"><div><p class="eyebrow"><%= module.eyebrow %></p><h1><%= module.title %></h1><span class="role-chip"><%= user.roleLabel %></span></div><div class="top-actions"><a class="button light-button" href="/">Dashboard</a><form method="post" action="/logout"><button class="logout-button" type="submit">Sign out</button></form></div></header><section class="module-hero"><p class="eyebrow light">AUTHORIZED TASK WORKSPACE</p><h2><%= module.description %></h2></section><section class="workspace-grid"><div class="panel form-panel"><p class="eyebrow">NEW RECORD</p><h3><%= actionTitle %></h3><form method="post" action="/workspace/<%= workspace %>" class="workspace-form"><% if (workspace === 'assessments') { %><label>Title<input name="title" required></label><label>Date<input name="assessmentDate" type="date"></label><label>Maximum score<input name="maxScore" type="number" min="1" value="100" required></label><% } else if (workspace === 'grades') { %><label>Assessment<select name="assessmentId" required><option value="" disabled selected>Select assessment</option><% assessments.forEach(function(item) { %><option value="<%= item.id %>"><%= item.title %></option><% }); %></select></label><label>Student<select name="studentId" required><option value="" disabled selected>Select student</option><% students.forEach(function(item) { %><option value="<%= item.id %>"><%= item.full_name %></option><% }); %></select></label><label>Score<input name="score" type="number" min="0" step="0.01" required></label><label>Feedback<textarea name="feedback"></textarea></label><% } else if (workspace === 'timetable') { %><label>Class<select name="classId"><option value="">Select class</option><% classes.forEach(function(item) { %><option value="<%= item.id %>"><%= item.name %></option><% }); %></select></label><label>Subject<select name="subjectId"><option value="">Select subject</option><% subjects.forEach(function(item) { %><option value="<%= item.id %>"><%= item.name %></option><% }); %></select></label><label>Weekday<select name="weekday"><option value="1">Monday</option><option value="2">Tuesday</option><option value="3">Wednesday</option><option value="4">Thursday</option><option value="5">Friday</option></select></label><label>Starts<input name="startsAt" type="time" required></label><label>Ends<input name="endsAt" type="time" required></label><label>Room<input name="room"></label><% } else if (workspace === 'trips') { %><label>Route<select name="routeId"><option value="">Select route</option><% routes.forEach(function(item) { %><option value="<%= item.id %>"><%= item.name %></option><% }); %></select></label><label>Vehicle<select name="vehicleId"><option value="">Select vehicle</option><% vehicles.forEach(function(item) { %><option value="<%= item.id %>"><%= item.registration_number %></option><% }); %></select></label><label>Driver<select name="driverId"><option value="">Select driver</option><% drivers.forEach(function(item) { %><option value="<%= item.id %>"><%= item.full_name %></option><% }); %></select></label><label>Date<input name="tripDate" type="date" required></label><label>Status<select name="status"><option value="scheduled">Scheduled</option><option value="in_progress">In progress</option><option value="completed">Completed</option><option value="cancelled">Cancelled</option></select></label><% } else { %><label>Route<select name="routeId" required><option value="" disabled selected>Select route</option><% routes.forEach(function(item) { %><option value="<%= item.id %>"><%= item.name %></option><% }); %></select></label><label>Student<select name="studentId" required><option value="" disabled selected>Select student</option><% students.forEach(function(item) { %><option value="<%= item.id %>"><%= item.full_name %></option><% }); %></select></label><% } %><button class="button" type="submit">Save record <span>→</span></button></form></div><div class="panel table-panel"><p class="eyebrow">RECORDS</p><h3><%= records.length %> records</h3><% if (records.length) { %><table><thead><tr><% Object.keys(records[0]).slice(0, 8).forEach(function(key) { %><th><%= key.replaceAll('_', ' ') %></th><% }); %></tr></thead><tbody><% records.forEach(function(record) { %><tr><% Object.keys(records[0]).slice(0, 8).forEach(function(key) { %><td><%= record[key] || '-' %></td><% }); %></tr><% }); %></tbody></table><% } else { %><p class="empty-state">No records yet.</p><% } %></div></section></main></div></body></html>
